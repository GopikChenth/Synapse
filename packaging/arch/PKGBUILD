# Maintainer: ArcadeLabs <contact@arcadelabs.com>
pkgname=synapse
pkgver=1.0.0
pkgrel=1
pkgdesc="Continuous Peer-to-Peer File Synchronization Client"
arch=('x86_64' 'aarch64')
url="https://github.com/GopikChenth/Synapse"
license=('GPL3')
depends=('java-runtime>=17' 'syncthing' 'hicolor-icon-theme')
provides=('synapse')
conflicts=('synapse-git')

source=("synapse.desktop")
sha256sums=('SKIP')

build() {
    # If a JAR already exists in local directory or build output, skip Gradle
    if ls *.jar 1>/dev/null 2>&1 || ls "${startdir}"/*.jar 1>/dev/null 2>&1; then
        echo "Using existing local JAR file..."
        return 0
    fi
    cd "${srcdir}/../../.." 2>/dev/null || true
    if ! find app/desktopApp/build/compose/jars -name "*.jar" 2>/dev/null | grep -q .; then
        ./gradlew :app:desktopApp:packageReleaseUberJarForCurrentOS --no-daemon || ./gradlew :app:desktopApp:packageUberJarForCurrentOS --no-daemon
    fi
}

package() {
    # Find JAR file (checks startdir, srcdir, repo root)
    JAR_FILE=$(find "${startdir}" "${srcdir}" "${srcdir}/../../.." -maxdepth 5 -name "*.jar" 2>/dev/null | head -n 1)

    if [ -z "$JAR_FILE" ]; then
        echo "ERROR: No JAR file found!"
        exit 1
    fi

    # Install application JAR
    install -Dm755 "${JAR_FILE}" "${pkgdir}/usr/share/synapse/Synapse.jar"

    # Create executable launcher script in /usr/bin/synapse
    mkdir -p "${pkgdir}/usr/bin"
    cat << 'EOF' > "${pkgdir}/usr/bin/synapse"
#!/bin/sh
# Ensure Linux daemon directory and symlink exist for Synapse
mkdir -p "$HOME/Synapse/bin"
SYSTEM_SYNCTHING=$(which syncthing 2>/dev/null || echo "/usr/bin/syncthing")
if [ -x "$SYSTEM_SYNCTHING" ] && [ ! -x "$HOME/Synapse/bin/syncthing.exe" ]; then
    ln -sf "$SYSTEM_SYNCTHING" "$HOME/Synapse/bin/syncthing.exe"
fi

exec java -jar /usr/share/synapse/Synapse.jar "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/synapse"

    # Install desktop launcher menu entry
    install -Dm644 "${srcdir}/synapse.desktop" "${pkgdir}/usr/share/applications/synapse.desktop"

    # Install application icon
    if [ -f "${srcdir}/../../synapse_logo_silhouette.png" ]; then
        install -Dm644 "${srcdir}/../../synapse_logo_silhouette.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/synapse.png"
    elif [ -f "${srcdir}/../../transparent_logo.png" ]; then
        install -Dm644 "${srcdir}/../../transparent_logo.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/synapse.png"
    fi
}
