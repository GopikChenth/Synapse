+#[tokio::test]
+async fn test_security_p2p_rejects_poisoned_or_traversal_chunks() {
+    use synapse_core::p2p::P2PMessage;
+    let harness = TestHarness::new();
+    let p2p = harness.app_state.p2p_manager.clone();
+    let peer = Some("192.0.2.10:9190".parse().unwrap());
+
+    // Payload that doesn't match its claimed hash is dropped.
+    let honest = b"real chunk bytes".to_vec();
+    let claimed = blake3::hash(&honest).to_hex().to_string();
+    p2p.handle_p2p_message(P2PMessage::ChunkResponse { chunk_hash: claimed.clone(), data: b"poison".to_vec() }, peer)
+        .await.unwrap();
+    assert!(!harness.storage.has_chunk(&claimed));
+
+    // Path traversal in the chunk ID is dropped and nothing is written.
+    let escape = harness.temp_dir.join("escaped");
+    let evil = format!("../../../{}", escape.display());
+    p2p.handle_p2p_message(P2PMessage::ChunkResponse { chunk_hash: evil.clone(), data: b"x".to_vec() }, peer)
+        .await.unwrap();
+    assert!(!harness.temp_dir.join("escaped.chunk").exists());
+    let reply = p2p.handle_p2p_message(P2PMessage::ChunkRequest { chunk_hash: evil }, peer).await.unwrap();
+    assert!(reply.is_none());
+
+    // A matching payload is stored.
+    p2p.handle_p2p_message(P2PMessage::ChunkResponse { chunk_hash: claimed.clone(), data: honest.clone() }, peer)
+        .await.unwrap();
+    assert_eq!(harness.storage.get_chunk(&claimed).unwrap().unwrap(), honest);
+}
