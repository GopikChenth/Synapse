+    assert_eq!(api_json(&router, "POST", &format!("/api/v1/devices/{}/pause", id)).await.0, StatusCode::OK);
+    let (_, dev) = api_json(&router, "GET", &format!("/api/v1/devices/{}", id)).await;
+    assert_eq!(dev["pairing_state"], "paused");
